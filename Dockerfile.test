# Test stage
FROM python:3.12-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy application code and tests
COPY requirements.txt .
COPY src/ src/
COPY tests/ tests/
COPY pytest.ini .

# Install Python dependencies
RUN python -m venv /opt/venv && \
    . /opt/venv/bin/activate && \
    pip install --no-cache-dir -r requirements.txt pytest pytest-cov pytest-asyncio pytest-benchmark pytest-xdist

# Set environment variables
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONPATH="/app" \
    PYTHONUNBUFFERED=1

# Create test directories with appropriate permissions
RUN useradd -m -u 1000 testuser && \
    mkdir -p /app/test_data && \
    chown -R testuser:testuser /app/test_data && \
    chmod 700 /app/test_data

# Switch to test user
USER testuser

# Default command to run tests
CMD ["python", "-m", "pytest", "tests/test_filesystem_errors.py", "-v"] 